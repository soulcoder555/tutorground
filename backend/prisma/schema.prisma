generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TUTOR
  STUDENT
  PARENT
  ADMIN
}

enum TeachingMode {
  ONLINE
  OFFLINE
  BOTH
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  MISSED
}

enum SessionType {
  ONE_ON_ONE
  BATCH
  COMMUNITY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ActivityLevel {
  LOW
  MEDIUM
  HIGH
  EXCELLENT
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum PaymentStatus {
  PENDING
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum BackupRequestStatus {
  OPEN
  ASSIGNED
  CANCELLED
  COMPLETED
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String          @unique
  passwordHash   String
  role           Role
  avatarUrl      String?
  isVerified     Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tutorProfile   TutorProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@index([role])
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TutorProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  bio               String
  subjects          String[]
  classesTeaching   String[]
  hourlyRate        Float
  teachingMode      TeachingMode
  experienceYears   Int
  qualifications    String[]
  verificationLevel Int                 @default(0)
  ratingAvg         Float               @default(0)
  totalReviews      Int                 @default(0)
  studentCount      Int                 @default(0)
  totalSessions     Int                 @default(0)
  isAvailable       Boolean             @default(true)
  profileUrl        String              @unique
  latitude          Float
  longitude         Float
  address           String
  city              String
  state             String
  gender            String?
  teachingStyle     String?
  punctualityScore  Float               @default(100)
  responseRate      Float               @default(100)
  consistencyScore  Float               @default(100)
  smartMatchScore   Float               @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification      TutorVerification?
  availability      AvailabilitySlot[]
  sessions          Session[]
  attendances       Attendance[]
  homework          Homework[]
  proofCards        TeachingProofCard[]
  bookings          Booking[]
  reviews           Review[]
  earnings          Earning[]

  @@index([city, state])
  @@index([latitude, longitude])
}

model TutorVerification {
  id         String             @id @default(cuid())
  tutorId    String             @unique
  idProofUrl String?
  degreeUrl  String?
  photoUrl   String?
  status     VerificationStatus @default(PENDING)
  adminNotes String?
  verifiedAt DateTime?
  verifiedBy String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tutor      TutorProfile       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id        String       @id @default(cuid())
  tutorId   String
  dayOfWeek Int
  startTime String
  endTime   String
  mode      TeachingMode @default(BOTH)
  isActive  Boolean      @default(true)
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, dayOfWeek])
}

model StudentProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  class             String
  subjects          String[]
  parentId          String?
  linkCode          String             @unique
  latitude          Float?
  longitude         Float?
  city              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            ParentProfile?     @relation(fields: [parentId], references: [id])
  attendance        Attendance[]
  submissions       HomeworkSubmission[]
  passport          LearningPassport?
  bookings          Booking[]
  reviews           Review[]
}

model ParentProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  studentIds String[]
  latitude   Float
  longitude  Float
  address    String
  city       String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  children   StudentProfile[]
  bookings   Booking[]
  reviews    Review[]

  @@index([city])
}

model Session {
  id                 String             @id @default(cuid())
  tutorId            String
  studentIds         String[]
  subject            String
  classLevel         String
  scheduledAt        DateTime
  durationMins       Int
  mode               TeachingMode
  sessionType        SessionType        @default(ONE_ON_ONE)
  status             SessionStatus      @default(SCHEDULED)
  meetingLink        String?
  jitsiRoomId        String?
  topicsCovered      String?
  homeworkAssigned   Boolean            @default(false)
  proofCardGenerated Boolean            @default(false)
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  isRecurring        Boolean            @default(false)
  recurringPattern   String?
  matchScore         Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tutor              TutorProfile       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  attendance         Attendance[]
  homework           Homework[]
  proofCard          TeachingProofCard?
  earnings           Earning[]

  @@index([tutorId, scheduledAt])
  @@index([status])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  tutorId   String
  status    AttendanceStatus
  markedAt  DateTime         @default(now())
  note      String?
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor     TutorProfile     @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Homework {
  id          String                @id @default(cuid())
  sessionId   String
  tutorId     String
  studentIds  String[]
  title       String
  description String?
  fileUrl     String?
  dueDate     DateTime
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  session     Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tutor       TutorProfile          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([sessionId])
  @@index([tutorId])
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  fileUrl     String?
  textAnswer  String?
  submittedAt DateTime       @default(now())
  feedback    String?
  score       Int?
  topicTags   String[]
  isReviewed  Boolean        @default(false)
  reviewedAt  DateTime?
  homework    Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
}

model TeachingProofCard {
  id                   String        @id @default(cuid())
  sessionId            String        @unique
  tutorId              String
  parentIds            String[]
  topicsCovered        String
  doubtsSolved         String?
  homeworkAssigned     Boolean
  homeworkDetails      String?
  studentActivityLevel ActivityLevel
  durationMins         Int
  startTime            DateTime
  endTime              DateTime
  tutorNotes           String?
  generatedAt          DateTime      @default(now())
  isDelivered          Boolean       @default(false)
  session              Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tutor                TutorProfile  @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model LearningPassport {
  id              String         @id @default(cuid())
  studentId       String         @unique
  strongTopics    String[]
  weakTopics      String[]
  totalSessions   Int            @default(0)
  subjectsStudied String[]
  achievements    String[]
  teachersHistory String[]
  updatedAt       DateTime       @updatedAt
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Review {
  id                 String         @id @default(cuid())
  tutorId            String
  parentId           String
  studentId          String
  rating             Float
  writtenReview      String
  sessionCountAtTime Int
  isVerified         Boolean        @default(true)
  createdAt          DateTime       @default(now())
  tutor              TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  parent             ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model Booking {
  id            String        @id @default(cuid())
  tutorId       String
  parentId      String
  studentId     String
  subject       String
  classLevel    String
  mode          TeachingMode
  preferredTime String
  message       String?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  respondedAt   DateTime?
  tutor         TutorProfile  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  parent        ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tutorId, status])
  @@index([parentId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Earning {
  id             String        @id @default(cuid())
  tutorId        String
  sessionId      String?
  amount         Float
  platformFee    Float         @default(0)
  netAmount      Float
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  razorpayOrderId String?
  createdAt      DateTime      @default(now())
  tutor          TutorProfile  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  session        Session?      @relation(fields: [sessionId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String?
  parentId          String
  tutorId           String
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model BackupRequest {
  id             String              @id @default(cuid())
  sessionId      String?
  parentId       String
  studentId      String
  subject        String
  classLevel     String
  city           String
  preferredTime  String
  status         BackupRequestStatus @default(OPEN)
  assignedTutorId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model LocalCommunity {
  id          String   @id @default(cuid())
  name        String
  city        String
  subject     String?
  description String?
  memberIds   String[]
  createdAt   DateTime @default(now())
}

